# Fibonacci.bassm
# Author: Andrew Masker

def r_pc_init = r8                              # Define 
def r_counter = r4                              # The register with the counter
def r_low = r1                                  # The register with the low number
def r_high = r2                                 # The register with the high number
def r_result = r3                               # The result register
def r_loop = r6                                 # Define the loop register as r6
def r_loop_escape = r7                          # Define the loop escape register as r7
def r_one = r5                                  # Define one to be the register r5
def r_index = r40          
def r_left = r41   
def r_fib_index = r42
def r_addr = r31

def fib_index = 20                              # The Fibonacci number to compute. Must be greater than or equal to 1
liw $r_fib_index , $fib_index

!LABEL_ORIGIN
pc $r_pc_init                                   # Put the initial pc into pc_init
sjo $r_pc_init                                  # Set the jump origin to r_pc_init

liw $r_addr , :prep_screen                     
jmp $r_addr 
done_prep: 

liw $r_loop , :loop                             # Load the relative loop address into the loop register

liw $r_loop_escape , :loop_escape               # Load the loop_escape address into the loop_escape register

lib $r_one , (1)                                # Set the register one to 1

calc_fib:
sub $r_fib_index , $r_index , $r_left
add $r_index , $r_one , $r_index
liw $r_addr , :done                             # Load the loop_escape address into the loop_escape register
bz $r_left , $r_addr
mov $r_index , $r_counter                       # Set the counter register to fib_index

lib $r_low , ( 0 )                              # Load zero into the low register as a byte
mov $r_one , $r_high                            # Copy register one into register high
mov $r_high , $r_result                         # Move high into result

loop:                                           # Define the loop label
    bz $r_counter , $r_loop_escape              # Branch to the address in the loop escape register if the counter register is zero
    add $r_low , $r_high , $r_result            # Add low and high together and store in result
    mov $r_high , $r_low                        # Move high into low
    mov $r_result , $r_high                     # Move result into high
    sub $r_counter , $r_one , $r_counter        # Subtract one from counter 
    jmp $r_loop                                 # Jump back to the begining of the loop

loop_escape:                                    # Define the loop_escape label and show
    liw $r_addr , :write_result                 # Load the :write_result address into the address register
    jmp $r_addr                                 # Jump to the :write_result address

# These are all of the registers for the screen
def SCREEN = 0xFA00
def MODE = ( $SCREEN )
def CMODE = ( $SCREEN + 1 )
def CX = ( $SCREEN + 2 )
def CY = ( $SCREEN + 3 )
def FIDX = ( $SCREEN + 4 )
def FR = ( $SCREEN + 5)
def FG = ( $SCREEN + 6)
def FB = ( $SCREEN + 7)
def BIDX = ( $SCREEN + 8 )
def BR = ( $SCREEN + 9 )
def BG = ( $SCREEN + 10 )
def BB = ( $SCREEN + 11 )
def WIDTH = ( $SCREEN + 12 )
def HEIGHT = ( $SCREEN + 13 )
def CELL = ( $SCREEN + 14 )
def BLIT = ( $SCREEN + 15 )
def FILL = ( $SCREEN + 16 )
def RESET = ( $SCREEN + 17 )

# Since we are done with the calculation, we only care about the result register which is r3

def r_1 = r32
def r_ascii = r33
def r_four = r34         
def r_nib_mask = r35
def r_col = r36
def r_row = r37

prep_screen:
    liw $r_addr , $FILL
    stb r10 , $r_addr
    liw $r_addr , $BLIT                         # Load the BLIT address into the address register
    stb r10 , $r_addr                           # Store anything to the BLIT address to blit the screen

    liw $r_addr , :done_prep                        
    jmp $r_addr                                 


write_result:

lib $r_one , 1                                  # Set the register one to 1

lib $r_four , 4                                 # Set the register one to 1

def nib_mask = 0xF
lib $r_nib_mask , $nib_mask


liw $r_addr , $WIDTH
ldb $r_addr , $r_col
sub $r_col , $r_one , $r_col
lib $r_col , 45

hex_loop:
    mov $r_result , $r_1                        # Move a working copy of th result into r_1
    lsr $r_result , $r_four , $r_result         # Shift the result by one nibble right
    and $r_1 , $r_nib_mask , $r_1               # AND the working copy with the nibble mask to get the lower nibble
    liw $r_addr , :hex_table                    # Load the address of the hex_table into the address register
    add $r_addr , $r_pc_init , $r_addr          # Add the pc_init to the address register as loads are absolute
    add $r_addr , $r_1 , $r_addr                # ADD the nibble to the address to get the correct address for a given nibble
    ldb $r_addr , $r_ascii                      # load the ascii byte from the table into the ascii register
    liw $r_addr , $CX                           # Load the cursor x address into the address register
    stb $r_col , $r_addr                        # Store the current column in the cursor x address
    sub $r_col , $r_one , $r_col                # Decrement the column register by one
    liw $r_addr , $CELL                         # Load the cell address to into the address register
    stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address
    liw $r_addr , :hex_done                     # Load the :hex_done address into the address register
    bz $r_result , $r_addr                      # If the result after shifting is zero, then jumpt to :hex_done              
    liw $r_addr , :hex_loop                     # Load the :hex_loop address into the address register
    jmp $r_addr                                 # Jump to the :hex_loop address

hex_done:
    liw $r_addr , $CX                           # Load the cursor x address into the address register
    stb $r_col , $r_addr                        # Store the current column in the cursor x address
    sub $r_col , $r_one , $r_col                # Decrement the column register by one
    lib $r_ascii , 0x78                         # Load the byte for 'x' into the ascii register
    liw $r_addr , $CELL                         # Load the cell address to into the address register
    stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address

    liw $r_addr , $CX                           # Load the cursor x address into the address register
    stb $r_col , $r_addr                        # Store the current column in the cursor x address
    sub $r_col , $r_one , $r_col                # Decrement the column register by one
    lib $r_ascii , 0x30                         # Load the byte for '0' into the ascii register
    liw $r_addr , $CELL                         # Load the cell address to into the address register
    stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address

    liw $r_addr , $BLIT                         # Load the BLIT address into the address register
    stb r10 , $r_addr                           # Store anything to the BLIT address to blit the screen

    liw $r_addr , $CY                           # Load the cursor y address into the address register
    add $r_row , $r_one , $r_row                # Increment the row register by one
    stb $r_row , $r_addr                        # Store the current row in the cursor y address

    liw $r_addr , :calc_fib                     # Load the :hex_loop address into the address register
    jmp $r_addr                                 # Jump to the :hex_loop address

done:
liw $r_addr , $CY                           # Load the cursor y address into the address register
add $r_row , $r_one , $r_row                # Increment the row register by one
stb $r_row , $r_addr                        # Store the current row in the cursor y address
liw $r_addr , $CX                           # Load the cursor x address into the address register
stb $r_col , $r_addr                        # Store the current column in the cursor x address
sub $r_col , $r_one , $r_col                # Decrement the column register by one
lib $r_ascii , 0x21                         # Load the byte for 'x' into the ascii register
liw $r_addr , $CELL                         # Load the cell address to into the address register
stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address
liw $r_addr , $BLIT                         # Load the BLIT address into the address register
stb r10 , $r_addr                           # Store anything to the BLIT address to blit the screen
hlt


hex_table:
    db 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46