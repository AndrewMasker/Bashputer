# Snake.bassm - snake written in bassm for the bashputer
# Author: Andrew Masker
# 
# ==================================================================================
# PREAMBLE
# ==================================================================================
#
# CONTROLS:
#       w: turn upwards if traveling left or right
#       a: turn left (screen relative) if traveling up or down
#       s: turn downwards if traveling left or right
#       d: turn right (screen relative) if traveling up or down
#       q: quit the game
#
#
# ==================================================================================
# SUBSTITUTIONS
# ==================================================================================
#
# MEMORY MAPPED IO: This section was in part taken from the Showcase.bassm
# Memory map
def SCREEN   = ( 1 * 64 * 1000 )
def KEYBOARD = ( 3 * 64 * 1000 )
def TIMER    = ( 4 * 64 * 1000 )
def RAM      = ( 6 * 64 * 1000 )

# Screen registers 
def MODE  = ( $SCREEN + 0 )                 # 0 = characters, 1 = half-block pixels
def CMODE = ( $SCREEN + 1 )                 # 0 = palette index, 1 = 24-bit RGB
def CX    = ( $SCREEN + 2 )
def CY    = ( $SCREEN + 3 )
def FIDX  = ( $SCREEN + 4 )
def FR    = ( $SCREEN + 5 ) ; def FG = ( $SCREEN + 6 ) ; def FB = ( $SCREEN + 7 )
def BIDX  = ( $SCREEN + 8 )
def BR    = ( $SCREEN + 9 ) ; def BG = ( $SCREEN + 10 ) ; def BB = ( $SCREEN + 11 )
def CELL  = ( $SCREEN + 14 )
def BLIT  = ( $SCREEN + 15 )
def FILL  = ( $SCREEN + 16 )
def R_FIDX= ( $SCREEN + 18 )
def R_BIDX= ( $SCREEN + 22 )

# Keyboard registers
def KB_STATUS = ( $KEYBOARD + 0 )           # 1 while a key is waiting
def KB_DATA   = ( $KEYBOARD + 1 )           # reading pops one byte
def KB_CLEAR  = ( $KEYBOARD + 2 )           # reading flushes the buffer

# Timer registers
def TIMER_RESET = ( $TIMER + 0 )            # any write restarts the count
def TIMER_LATCH = ( $TIMER + 1 )            # any write captures the count
def TIMER_TICKS = ( $TIMER + 2 )            # 8 bytes, 1 tick = 1 ms

def RESET_SP = ( 22*64*1000 )

# ==================================================================================
# REGISTERS
# ==================================================================================

def r_addr = r0                             # The address register
def r_timer = r1                            # The timer register
def r_zero = r2                             # Dedicated empty register
def r_origin = r3                           # The register that holds 
def r_unsafe = r4                           # Dedicated scratch register
def r_more = r5                             # Register to hold the countdown index
def r_index = r6                            # Register to hold the current index
def r_cond = r7                             # Register to hold the condition
def r_one = r8                              # Register which will hold one
def r_should_go = r9                        # Register holding the should_go bool
def r_kb_status = r10                       # Register holding the status of the keyboard 
def r_kb_data = r11                         # Register holding the keyboard data
def r_dir = r12                             # Direction register 0b00 = up , 0b01 = left , 0b10 = down , 0b11 = right
def r_op_dir = r13                          # For holding the opposite of the current direction
def r_hx_addr = r14
def r_hy_addr = r15
def r_tx_addr = r16
def r_ty_addr = r17
def r_up = r18
def r_left = r19
def r_down = r20
def r_right = r21
def r_w = r22
def r_a = r23
def r_s = r24
def r_d = r25
def r_q = r26
def r_background = r27
def r_snake = r28
def r_apples = r29
def r_walls = r30
def r_xs_addr = r31
def r_xe_addr = r32
def r_ys_addr = r33
def r_ye_addr = r34
def r_x = r35
def r_y = r36
def r_two = r37
def r_color = r38
def r_growth = r39
def r_rem = r40
def r_width = r41
def r_height = r42
def r_p_height = r43
def r_no_apple = r44

# ==================================================================================
# CONSTANTS
# ==================================================================================
#
# COLORS:
def background = 0x10
def snake = 0x0A
def apples = 0x09
def walls = 0x0F

# PLAY AREA:
def width = 30                            # Cell width of the playable area
def height = 15                           # Cell height of the playable area
def p_height = ( $height * 2 )

# TIMING:
def time_step = 1

# KEYS:
def w = 0x77
def a = 0x61
def s = 0x73
def d = 0x64
def q = 0x71

# SNAKE RING BUFFERS
def xs_addr = $RAM                                         # Inclusive
def xe_addr = ( $xs_addr + ( $width * $p_height ) + 1)     # Exclusive (one is added so we don't have to worry about write order)
def ys_addr = $xe_addr                                       # Inclusive
def ye_addr = ( $xe_addr + ( $width * $p_height ) + 1)       # Exclusive (one is added so we don't have to worry about write order)

def snake_init_len = 3

# ==================================================================================
# MACROS
# ==================================================================================
#
# GENERAL:
    # fori[i= , to= , do= ] - does @do @to-@i times starting at @i. @i and @to are limited to a quarter
    def fori = 
    {
        pshq $r_index
        pshq $r_more
        liq $r_more , ( @to - @i )
        lib $r_index , @i
        bzi $r_more , :.endfor
        loop:
            !scope
                @do
            !endscope
        next:
            dec $r_more
            inc $r_index
            bnzi $r_more , :.loop
        endfor:
            popq $r_more
            popq $r_index
    }

    # whilei[reg= , is= , val= , do= ] - does @do while @reg is @is to @val. @val is limited to a quarter
    def whilei = 
    {
        loop:
            liq $r_cond , @val
            @is @reg , $r_cond , $r_cond
            bzi $r_cond , :.endwhile
            !scope
                @do
            !endscope
            jmpi :.loop
        endwhile:
    }

    # while[reg= , is= , val= , do= ] - does @do while @reg is @is to the value in @val.
    def while = 
    {
        loop:
            @is @reg , @val , $r_cond
            bzi $r_cond , :.endwhile
            !scope
                @do
            !endscope
            jmpi :.loop
        endwhile:
    }

    # ifi[reg= , is= , val= , do= , elsedo=] - does @do if @reg is @is to @val else does @elsedo. @val is limited to a quarter
    def ifi = 
    {
        liq $r_cond , @val
        @is @reg , $r_cond , $r_cond
        bzi $r_cond , :.else
        !scope
            @do
        !endscope
        jmpi :.endif
        else:
            !scope
                @elsedo
            !endscope
        endif:
    }

    # if[reg= , is= , val= , do= , elsedo=] - does @do if @reg is @is to the value in @val else does @elsedo
    def if = 
    {
        @is @reg , @val , $r_cond
        bzi $r_cond , :.else
        !scope
            @do
        !endscope
        jmpi :.endif
        else:
            !scope
                @elsedo
            !endscope
        endif:
    }

    # wheni[reg= , is= , val= , do=] - does @do if @reg is @is to @val else does nothing. @val is limited to a quarter
    def wheni = 
    {
        liq $r_cond , @val
        @is @reg , $r_cond , $r_cond
        bzi $r_cond , :.endif
        !scope
            @do
        !endscope
        endif:
    }

    # when[reg= , is= , val= , do=] - does @do if @reg is @is to the value in @val else does nothing
    def when = 
    {
        @is @reg , @val , $r_cond
        bzi $r_cond , :.endif
        !scope
            @do
        !endscope
        endif:
    }

# DATA HANDLING:
    # peek[addr= , reg= ] - sets register to the value stored in the address
    def peek = 
    {
        liw $r_addr , @addr
        ldb $r_addr , @reg
    }

    # poke[addr= , reg= ] - sets the address to the value stored in the low byte of the register
    def poke = 
    {
        liw $r_addr , @addr
        stb @reg , $r_addr
    }

    # pokei[addr= , val= ] - sets the address to the value (byte only)
    def pokei = 
    {
        liw $r_addr , @addr
        lib $r_unsafe , @val
        stb $r_unsafe , $r_addr
    }

    def bid_table_read = 
    {
        liw $r_addr , @table
        add $r_addr , $r_origin , $r_addr
        add $r_addr , @offset , $r_addr
        ldb $r_addr , @reg
    }

    def bid_table_readi = 
    {
        lib $r_unsafe , @offset
        liw $r_addr , @table
        add $r_addr , $r_origin , $r_addr
        add $r_addr , $r_unsafe , $r_addr
        ldb $r_addr , @reg
    }

# TIMER READING:
    # reset_timer - resets the timer 
    def reset_timer = 
    {
        $poke[addr = $TIMER_RESET , reg = $r_zero]
    }

    # read_timer - reads the timer 
    def read_timer = 
    {
        $poke[addr = $TIMER_LATCH , reg = $r_zero]
        liw $r_addr , $TIMER_TICKS
        ldw $r_addr , $r_timer
    }

# GLOBAL GAME MACROS:
    def change_dir = {
        $bid_table_read[reg=$r_op_dir , offset=@todir , table=:OP_DIR_TABLE] # Read the opposite direction of the way we are trying to turn
        $when[reg=$r_dir , is=eq , val=$r_op_dir , do=jmpi :.endchange_dir ] # Skip if our current direction is the opposite of the way we are trying to turn
        mov @todir , $r_dir
        endchange_dir:
    }

    def set_cursor = {
        $poke[addr = $CX , reg=$r_x]
        div $r_y , $r_two , $r_unsafe
        $poke[addr = $CY , reg=$r_unsafe]
        rem $r_y , $r_two , $r_rem
    }

# ==================================================================================
# INITIALIZATION AND FUNCTIONS
# ==================================================================================

    !label_origin
    pc $r_origin
    sjo $r_origin

    RESET:
    SSPI $RESET_SP

    # REGISTER INITIALIZATION
    lib $r_one , 1
    lib $r_should_go , 1
    lib $r_up , 0b00
    lib $r_left , 0b01
    lib $r_down , 0b10
    lib $r_right , 0b11
    lib $r_w , $w
    lib $r_a , $a
    lib $r_s , $s
    lib $r_d , $d
    lib $r_q , $q
    lib $r_background , $background
    lib $r_snake , $snake
    lib $r_apples , $apples
    lib $r_walls , $walls
    liw $r_xs_addr , $xs_addr
    liw $r_xe_addr , $xe_addr
    liw $r_ys_addr , $ys_addr
    liw $r_ye_addr , $ye_addr
    liw $r_two , 2
    lib $r_growth , 0
    lib $r_width , $width
    lib $r_height , $height
    lib $r_p_height , $p_height
    lib $r_no_apple , 1

    jmpi :END_FUNCTIONS

    !scope reset_screen 
        $poke[addr=$CMODE , reg=$r_zero]               # Set the screen to id based color mode
        $poke[addr=$BIDX , reg=$r_background]          # Set the background id to the backround color
        $poke[addr=$FILL , reg=$r_zero]                # Fill the 
        $poke[addr=$MODE , reg=$r_one]                 # Set the screen to pixel mode
        $poke[addr=$BLIT , reg=$r_zero]

        def line_init = {
            $pokei[addr=@axis , val=@where]
            $poke[addr=$FIDX , reg=@top]
            $poke[addr=$BIDX , reg=@bottom]
        }

        def line_body = {
            $poke[addr=@axis , reg=$r_index]
            $poke[addr=$CELL , reg=$r_zero]
            $poke[addr=$BLIT , reg=$r_zero]
        }

        $line_init[axis=$CY , where = 0 , top=$r_background , bottom=$r_walls]
        $fori[i=0 , to=($width + 2) , do=$line_body[axis=$CX]]

        $line_init[axis=$CY , where = ($height + 1) , top=$r_walls , bottom=$r_background]
        $fori[i=0 , to=($width + 2) , do=$line_body[axis=$CX]]

        $line_init[axis=$CX , where = 0 , top=$r_walls , bottom=$r_walls]
        $fori[i=1 , to=($height+1) , do=$line_body[axis=$CY]]

        $line_init[axis=$CX , where = ($width + 1) , top=$r_walls , bottom=$r_walls]
        $fori[i=1 , to=($height+1) , do=$line_body[axis=$CY]]

        $poke[addr=$BLIT , reg=$r_zero]

        undef line_init
        undef line_body

        ret
    !endscope

    !scope set_seed 
        ent $r_unsafe
        seed $r_unsafe

        ret
    !endscope

    !scope draw_pixel
        $set_cursor
        def is_top_pixel = {
            $poke[addr=$FIDX , reg=$r_color]
            $peek[addr=$R_BIDX , reg=$r_unsafe]
            $poke[addr=$BIDX , reg=$r_unsafe]
        }
        def is_bottom_pixel = {
            $poke[addr=$BIDX , reg=$r_color]
            $peek[addr=$R_FIDX , reg=$r_unsafe]
            $poke[addr=$FIDX , reg=$r_unsafe]
        }
        $if[reg=$r_rem , is=eq , val=$r_zero , do=$is_top_pixel , elsedo=$is_bottom_pixel]
        $poke[addr=$CELL , reg=$r_zero]

        undef is_top_pixel
        undef is_bottom_pixel

        ret
    !endscope

    !scope check_collisions
        $set_cursor
        $if[reg=$r_rem , is=eq , val=$r_zero , do=$peek[addr=$R_FIDX , reg=$r_color] , elsedo=$peek[addr=$R_BIDX , reg=$r_color]]
        $when[reg=$r_color , is=eq , val=$r_apples , do={inc $r_growth; mov $r_one , $r_no_apple ; jmpi :.skip}]
        $when[reg=$r_color , is=eq , val=$r_walls , do={jmpi :RESET}]
        $when[reg=$r_color , is=eq , val=$r_snake , do={jmpi :RESET}]
        skip:

        ret
    !endscope

    !scope push_head
        ldb $r_hx_addr , $r_x
        ldb $r_hy_addr , $r_y
        inc $r_hx_addr
        inc $r_hy_addr
        $when[reg=$r_hx_addr , is=eq , val=$r_xe_addr , do={mov $r_xs_addr , $r_hx_addr}]
        $when[reg=$r_hy_addr , is=eq , val=$r_ye_addr , do={mov $r_ys_addr , $r_hy_addr}]
        $when[reg=$r_dir , is=eq , val=$r_up ,   do={dec $r_y; jmpi :.skip}]
        $when[reg=$r_dir , is=eq , val=$r_left,  do={dec $r_x; jmpi :.skip}]
        $when[reg=$r_dir , is=eq , val=$r_down,  do={inc $r_y; jmpi :.skip}]
        $when[reg=$r_dir , is=eq , val=$r_right, do={inc $r_x; jmpi :.skip}]
        skip:
        cali :check_collisions
        mov $r_snake , $r_color
        cali :draw_pixel
        stb $r_x , $r_hx_addr
        stb $r_y , $r_hy_addr

        ret
    !endscope

    !scope pop_tail
        ldb $r_tx_addr , $r_x
        ldb $r_ty_addr , $r_y
        inc $r_tx_addr
        inc $r_ty_addr
        $when[reg=$r_tx_addr , is=eq , val=$r_xe_addr , do={mov $r_xs_addr , $r_tx_addr}]
        $when[reg=$r_ty_addr , is=eq , val=$r_ye_addr , do={mov $r_ys_addr , $r_ty_addr}]
        mov $r_background , $r_color
        cali :draw_pixel

        ret
    !endscope

    !scope snake_init
        mov $r_xs_addr , $r_tx_addr
        mov $r_ys_addr , $r_ty_addr
        mov $r_xs_addr , $r_hx_addr
        mov $r_ys_addr , $r_hy_addr
        mov $r_right , $r_dir

        lib $r_x , (($width / 2) + 1)
        lib $r_y , (($p_height/ 2) + 2)

        mov $r_snake , $r_color
        cali :draw_pixel
        stb $r_x , $r_hx_addr
        stb $r_y , $r_hy_addr

        ret
    !endscope

    !scope reset_snake
        cali :snake_init
        $fori[i=0 , to=($snake_init_len - 1) , do={cali :push_head}]

        ret
    !endscope

    !scope handle_keys
        def key_body = {
            $peek[addr = $KB_DATA , reg=$r_kb_data]
            $when[reg=$r_kb_data , is=eq , val=$r_w , do={$change_dir[todir=$r_up]; ret}]
            $when[reg=$r_kb_data , is=eq , val=$r_a , do={$change_dir[todir=$r_left]; ret}]
            $when[reg=$r_kb_data , is=eq , val=$r_s , do={$change_dir[todir=$r_down]; ret}]
            $when[reg=$r_kb_data , is=eq , val=$r_d , do={$change_dir[todir=$r_right]; ret}]
            $when[reg=$r_kb_data , is=eq , val=$r_q , do={$peek[addr=$KB_CLEAR , reg=$r_unsafe] ; hlt}]

            $peek[addr = $KB_STATUS , reg=$r_kb_status]
        }

        $peek[addr = $KB_STATUS , reg=$r_kb_status]
        $while[reg=$r_kb_status , is=eq , val=$r_one , do=$key_body]
        
        undef key_body

        ret
    !endscope

    !scope step_snake
        cali :push_head
        $if[reg=$r_growth , is=gt , val=$r_zero , do= {dec $r_growth} , elsedo={cali :pop_tail}]
        $when[reg=$r_no_apple , is=eq , val=$r_one , do={cali :spawn_apple; mov $r_zero , $r_no_apple}]
        ret
    !endscope

    !scope spawn_apple
        !scope try
            rnd $r_x
            lsr $r_x , $r_one , $r_x
            rem $r_x , $r_width , $r_x
            add $r_x , $r_one , $r_x

            rnd $r_y
            lsr $r_y , $r_one , $r_y
            rem $r_y , $r_p_height , $r_y
            add $r_y , $r_two , $r_y

            $set_cursor
            $if[reg=$r_rem , is=eq , val=$r_zero , do=$peek[addr=$R_FIDX , reg=$r_color] , elsedo=$peek[addr=$R_BIDX , reg=$r_color]]

            $if[reg=$r_color , is=eq , val=$r_snake , do={jmpi :.try} , elsedo={mov $r_apples , $r_color ; cali :draw_pixel}]
        !endscope

        ret
    !endscope

    !scope game_step
        $read_timer
        def step_body = 
        {
            $reset_timer
            cali :handle_keys
            cali :step_snake
            $poke[addr=$BLIT , reg=$r_zero]
        }
        $wheni[reg=$r_timer , is=ge , val=$time_step , do=$step_body]

        undef step_body

        ret
    !endscope

    END_FUNCTIONS:

# ==================================================================================
# PROGRAM
# ==================================================================================

    cali :set_seed
    cali :reset_screen
    cali :reset_snake
    $reset_timer
    $whilei[reg=$r_should_go , is=eq , val=1 , do = cali :game_step]

    stall:
    jmpi :stall

# ==================================================================================
# TABLES
# ==================================================================================

    OP_DIR_TABLE:
        db 0b10 , 0b11 , 0b00 , 0b01