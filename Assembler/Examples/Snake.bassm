# Snake.bassm - snake written in bassm for the bashputer
# Author: Andrew Masker
# 
# ==================================================================================
# PREAMBLE
# ==================================================================================
#
# CONTROLS:
#       w: turn upwards if traveling left or right
#       a: turn left (screen relative) if traveling up or down
#       s: turn downwards if traveling left or right
#       d: turn right (screen relative) if traveling up or down
#       q: quit the game
#
#
# ==================================================================================
# SUBSTITUTIONS
# ==================================================================================
#
# MEMORY MAPPED IO: This section was in part taken from the Showcase.bassm
# Memory map
def SCREEN   = ( 1 * 64 * 1000 )
def KEYBOARD = ( 3 * 64 * 1000 )
def TIMER    = ( 4 * 64 * 1000 )
def RAM      = ( 6 * 64 * 1000 )

# Screen registers 
def MODE  = ( $SCREEN + 0 )                 # 0 = characters, 1 = half-block pixels
def CMODE = ( $SCREEN + 1 )                 # 0 = palette index, 1 = 24-bit RGB
def CX    = ( $SCREEN + 2 )
def CY    = ( $SCREEN + 3 )
def FIDX  = ( $SCREEN + 4 )
def FR    = ( $SCREEN + 5 ) ; def FG = ( $SCREEN + 6 ) ; def FB = ( $SCREEN + 7 )
def BIDX  = ( $SCREEN + 8 )
def BR    = ( $SCREEN + 9 ) ; def BG = ( $SCREEN + 10 ) ; def BB = ( $SCREEN + 11 )
def CELL  = ( $SCREEN + 14 )
def BLIT  = ( $SCREEN + 15 )
def FILL  = ( $SCREEN + 16 )

# Keyboard registers
def KB_STATUS = ( $KEYBOARD + 0 )           # 1 while a key is waiting
def KB_DATA   = ( $KEYBOARD + 1 )           # reading pops one byte
def KB_CLEAR  = ( $KEYBOARD + 2 )           # reading flushes the buffer

# Timer registers
def TIMER_RESET = ( $TIMER + 0 )            # any write restarts the count
def TIMER_LATCH = ( $TIMER + 1 )            # any write captures the count
def TIMER_TICKS = ( $TIMER + 2 )            # 8 bytes, 1 tick = 1 ms

# ==================================================================================
# REGISTERS
# ==================================================================================
#
def r_addr = r0                             # The address register
def r_timer = r1                            # The timer register
def r_zero = r2                             # Dedicated empty register
def r_origin = r3                           # The register that holds 
def r_unsafe = r4                           # Dedicated scratch register
def r_more = r5                             # Register to hold the countdown index
def r_index = r6                            # Register to hold the current index
def r_cond = r7                             # Register to hold the condition
def r_one = r8                              # Register which will hold one
def r_should_go = r9                        # Register holding the should_go bool
def r_kb_status = r10                       # Register holding the status of the keyboard 
def r_kb_data = r11                         # Register holding the keyboard data
def r_dir = r12                             # Direction register 0b00 = up , 0b01 = left , 0b10 = down , 0b11 = right
def r_op_dir = r13                          # For holding the opposite of the current direction
def r_head_x = r14
def r_head_y = r15
def r_tail_x = r16
def r_tail_y = r17

# ==================================================================================
# CONSTANTS
# ==================================================================================
#
# COLORS:
def background = 0x10
def snake = 0x0A
def apples = 0x09
def walls = 0x0F

# PLAY AREA:
def width = 30                            # Cell width of the playable area
def height = 15                           # Cell height of the playable area
def p_height = ( $height * 2 )

# TIMING:
def time_step = 100

# KEYS:
def w = 0x77
def a = 0x61
def s = 0x73
def d = 0x64
def q = 0x71

# ==================================================================================
# MACROS
# ==================================================================================
#
# GENERAL:
    # fori[i= , to= , do= ] - does @do @to-@i times starting at @i. @i and @to are limited to a quarter
    def fori = 
    {
        pshq $r_index
        pshq $r_more
        liq $r_more , ( @to - @i )
        lib $r_index , @i
        bzi $r_more , :.endfor
        loop:
            !scope
                @do
            !endscope
        next:
            dec $r_more
            inc $r_index
            bnzi $r_more , :.loop
        endfor:
            popq $r_more
            popq $r_index
    }

    # whilei[reg= , is= , val= , do= ] - does @do while @reg is @is to @val. @val is limited to a quarter
    def whilei = 
    {
        loop:
            liq $r_cond , @val
            @is @reg , $r_cond , $r_cond
            bzi $r_cond , :.endwhile
            !scope
                @do
            !endscope
            jmpi :.loop
        endwhile:
    }

    # ifi[reg= , is= , val= , do= , elsedo=] - does @do if @reg is @is to @val else does @elsedo. @val is limited to a quarter
    def ifi = 
    {
        liq $r_cond , @val
        @is @reg , $r_cond , $r_cond
        bzi $r_cond , :.else
        !scope
            @do
        !endscope
        jmpi :.endif
        else:
            !scope
                @elsedo
            !endscope
        endif:
    }

    # wheni[reg= , is= , val= , do=] - does @do if @reg is @is to @val else does nothing. @val is limited to a quarter
    def wheni = 
    {
        liq $r_cond , @val
        @is @reg , $r_cond , $r_cond
        bzi $r_cond , :.endif
        !scope
            @do
        !endscope
        endif:
    }

    # when[reg= , is= , val= , do=] - does @do if @reg is @is to the value in @val else does nothing
    def when = 
    {
        @is @reg , @val , $r_cond
        bzi $r_cond , :.endif
        !scope
            @do
        !endscope
        endif:
    }

# DATA HANDLING:
    # peek[addr= , reg= ] - sets register to the value stored in the address
    def peek = 
    {
        liw $r_addr , @addr
        ldb $r_addr , @reg
    }

    # poke[addr= , reg= ] - sets the address to the value stored in the low byte of the register
    def poke = 
    {
        liw $r_addr , @addr
        stb @reg , $r_addr
    }

    # pokei[addr= , val= ] - sets the address to the value (byte only)
    def pokei = 
    {
        liw $r_addr , @addr
        lib $r_unsafe , @val
        stb $r_unsafe , $r_addr
    }

    def bid_table_readi = 
    {
        lib $r_unsafe , @offset
        liw $r_addr , @table
        add $r_addr , $r_unsafe , $r_addr
        ldb $r_addr , @reg
    }

# TIMER READING:
    # reset_timer - resets the timer 
    def reset_timer = 
    {
        $poke[addr = $TIMER_RESET , reg = $r_zero]
    }

    # read_timer - reads the timer 
    def read_timer = 
    {
        $poke[addr = $TIMER_LATCH , reg = $r_zero]
        liw $r_addr , $TIMER_TICKS
        ldw $r_addr , $r_timer
    }

# GLOBAL GAME MACROS:
    def change_dir = {
        $bid_table_readi[reg=$r_op_dir , offset=@todir , table=:OP_DIR_TABLE] # Read the opposite direction of the way we are trying to turn
        $when[reg=$r_dir , is=eq , val=$r_op_dir , do=jmpi :.endchange_dir ] # Skip if our current direction is the opposite of the way we are trying to turn
        lib $r_dir , @todir
        endchange_dir:
    }

# ==================================================================================
# INITIALIZATION AND FUNCTIONS
# ==================================================================================

    lib $r_one , 1
    lib $r_should_go , 1
    lib $r_head_x , (($width / 2) + 1)
    lib $r_head_y , (($height / 2) + 1)

    !label_origin
    pc $r_origin
    sjo $r_origin

    jmpi :END_FUNCTIONS

    !scope reset_screen 
        $pokei[addr=$CMODE , val = 0]               # Set the screen to id based color mode
        $pokei[addr=$BIDX , val=$background]        # Set the background id to the backround color
        $poke[addr=$FILL , reg=$r_zero]             # Fill the 
        $pokei[addr=$MODE , val = 1]                # Set the screen to pixel mode
        $poke[addr=$BLIT , reg=$r_zero]

        def line_init = {
            $pokei[addr=@axis , val = @where]
            $pokei[addr=$FIDX , val=@top]
            $pokei[addr=$BIDX , val=@bottom]
        }

        def line_body = {
            $poke[addr=@axis , reg=$r_index]
            $poke[addr=$CELL , reg=$r_zero]
            $poke[addr=$BLIT , reg=$r_zero]
        }

        $line_init[axis=$CY , where = 0 , top=$background , bottom=$walls]
        $fori[i=0 , to=($width + 2) , do=$line_body[axis=$CX]]

        $line_init[axis=$CY , where = ($height + 1) , top=$walls , bottom=$background]
        $fori[i=0 , to=($width + 2) , do=$line_body[axis=$CX]]

        $line_init[axis=$CX , where = 0 , top=$walls , bottom=$walls]
        $fori[i=1 , to=($height+1) , do=$line_body[axis=$CY]]

        $line_init[axis=$CX , where = ($width + 1) , top=$walls , bottom=$walls]
        $fori[i=1 , to=($height+1) , do=$line_body[axis=$CY]]

        $poke[addr=$BLIT , reg=$r_zero]

        undef line_init
        undef line_body

        ret
    !endscope

    !scope handle_keys
        def key_body = {
            $peek[addr = $KB_DATA , reg=$r_kb_data]
            $wheni[reg=$r_kb_data , is=eq , val=$w , do={$change_dir[todir=0b00] ; $poke[addr=$KB_CLEAR , reg=$r_zero] ; ret}]
            $wheni[reg=$r_kb_data , is=eq , val=$a , do={$change_dir[todir=0b01] ; $poke[addr=$KB_CLEAR , reg=$r_zero]; ret}]
            $wheni[reg=$r_kb_data , is=eq , val=$s , do={$change_dir[todir=0b10] ; $poke[addr=$KB_CLEAR , reg=$r_zero]; ret}]
            $wheni[reg=$r_kb_data , is=eq , val=$d , do={$change_dir[todir=0b11] ; $poke[addr=$KB_CLEAR , reg=$r_zero]; ret}]
            $wheni[reg=$r_kb_data , is=eq , val=$q , do={$poke[addr=$KB_CLEAR , reg=$r_zero] ; hlt}]

            $peek[addr = $KB_STATUS , reg=$r_kb_status]
        }

        $peek[addr = $KB_STATUS , reg=$r_kb_status]
        $whilei[reg=$r_kb_status , is=eq , val=1 , do=$key_body]
        
        undef key_body

        ret
    !endscope

    !scope step_snake
        $pokei[addr=$FIDX , val=$background]
        $pokei[addr=$BIDX , val=$background]
        $poke[addr=$CX , reg=$r_head_x]
        $poke[addr=$CY , reg=$r_head_y]
        $poke[addr=$CELL , reg = $r_zero]
        $wheni[reg=$r_dir , is=eq , val=0b00 , do={dec $r_head_y}]
        $wheni[reg=$r_dir , is=eq , val=0b01 , do={dec $r_head_x}]
        $wheni[reg=$r_dir , is=eq , val=0b10 , do={inc $r_head_y}]
        $wheni[reg=$r_dir , is=eq , val=0b11 , do={inc $r_head_x}]
        $pokei[addr=$FIDX , val=$snake]
        $pokei[addr=$BIDX , val=$snake]
        $poke[addr=$CX , reg=$r_head_x]
        $poke[addr=$CY , reg=$r_head_y]
        $poke[addr=$CELL , reg = $r_zero]

        ret
    !endscope

    !scope game_step
        $read_timer
        def step_body = 
        {
            $reset_timer
            cali :handle_keys
            cali :step_snake
            $poke[addr=$BLIT , reg=$r_zero]
        }
        $wheni[reg=$r_timer , is=ge , val=0 , do=$step_body]

        undef step_body

        ret
    !endscope

    END_FUNCTIONS:

# ==================================================================================
# PROGRAM
# ==================================================================================

    cali :reset_screen
    $reset_timer
    $whilei[reg=$r_should_go , is=eq , val=1 , do = cali :game_step]

    stall:
    jmpi :stall

# ==================================================================================
# TABLES
# ==================================================================================

    OP_DIR_TABLE:
        db 0b10 , 0b11 , 0b00 , 0b01