!LABEL_ORIGIN
def pc_init = r8                                # Define 
pc $pc_init                                     # Put the initial pc into pc_init
def counter = r4                                # The register with the counter
def low = r1                                    # The register with the low number
def high = r2                                   # The register with the high number
undef high                                      # Undefining this just to show
def high = r2                                   # Redefining so I can work with it
def result = r3                                 # The result register

def loop = r6                                   # Define the loop register as r6
liw $loop , :loop                               # Load the relative loop address into the loop register
add $loop , $pc_init , $loop                    # Add the pc_init value to the loop address to make the address absolute 

def loop_escape = r7                            # Define the loop escape register as r7
liw $loop_escape , :loop_escape                 # Load the loop_escape address into the loop_escape register
add $loop_escape , $pc_init , $loop_escape      # Add the pc_init value to the loop_escape address to make the address absolute 

def a = 1
def fib_index = 15                              # The Fibonacci number to compute. Must be greater than or equal to 1
def num_fib = ($fib_index - 1)                  # The number of fibonachi numbers to compute

def one = #small inline comment/# r5            # Define one to be the register r5
lib $one , (1)                                  # Set the register one to 1

liw $counter , $num_fib                         # Set the counter register to num_fib

lib $low , ( 0 )                                # Load zero into the low register as a byte
mov $one , $high                                # Copy register one into register high

loop:                                           # Define the loop label
    bz $counter , $loop_escape                  # Branch to the address in the loop escape register if the counter register is zero
    add $low , $high , $result                  # Add low and high together and store in result
    mov $high , $low; mov $result , $high       # Move high into low and result into high
    sub $counter , $one , $counter              # Subtract one from counter 
    jmp $loop                                   # Jump back to the begining of the loop

loop_escape:                                    # Define the loop_escape label and show

# These are all of the registers for the screen
def SCREEN = 0xFA00
def MODE = ( $SCREEN )
def CMODE = ( $SCREEN + 1 )
def CX = ( $SCREEN + 2 )
def CY = ( $SCREEN + 3 )
def FIDX = ( $SCREEN + 4 )
def FR = ( $SCREEN + 5)
def FG = ( $SCREEN + 6)
def FB = ( $SCREEN + 7)
def BIDX = ( $SCREEN + 8 )
def BR = ( $SCREEN + 9 )
def BG = ( $SCREEN + 10 )
def BB = ( $SCREEN + 11 )
def WIDTH = ( $SCREEN + 12 )
def HEIGHT = ( $SCREEN + 13 )
def CELL = ( $SCREEN + 14 )
def BLIT = ( $SCREEN + 15 )
def FILL = ( $SCREEN + 16 )
def RESET = ( $SCREEN + 17 )

# Since we are done with the calculation, we only care about the result register which is r3

def r_fib = r1
liw $r_fib , $num_fib

def r_result = $result

def r_addr = r2

def r_1 = r4
def r_ascii = r5

def r_one = r6                                  # Define one to be the register r5
lib $r_one , 1                                  # Set the register one to 1

def r_four = r9                                 # Define one to be the register r5
lib $r_four , 4                                 # Set the register one to 1

def nib_mask = 0xF
def r_nib_mask = r7
lib $r_nib_mask , $nib_mask

def r_col = r11
liw $r_addr , $WIDTH
ldb $r_addr , $r_col
sub $r_col , $r_one , $r_col
lib $r_col , 45

liw $r_addr , $FILL
stb r10 , $r_addr
liw $r_addr , $BLIT                         # Load the BLIT address into the address register
stb r10 , $r_addr                           # Store anything to the BLIT address to blit the screen

hex_loop:
    mov $r_result , $r_1                        # Move a working copy of th result into r_1
    lsr $r_result , $r_four , $r_result         # Shift the result by one nibble right
    and $r_1 , $r_nib_mask , $r_1               # AND the working copy with the nibble mask to get the lower nibble
    liw $r_addr , :hex_table                    # Load the address of the hex_table into the address register
    add $r_addr , $pc_init , $r_addr            # Add the offset to the address
    add $r_addr , $r_1 , $r_addr                # ADD the nibble to the address to get the correct address for a given nibble
    ldb $r_addr , $r_ascii                      # load the ascii byte from the table into the ascii register
    liw $r_addr , $CX                           # Load the cursor x address into the address register
    stb $r_col , $r_addr                        # Store the current column in the cursor x address
    sub $r_col , $r_one , $r_col                # Decrement the column register by one
    liw $r_addr , $CELL                         # Load the cell address to into the address register
    stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address
    liw $r_addr , :hex_done                     # Load the :hex_done address into the address register
    add $r_addr , $pc_init , $r_addr            # Add the offset to the address
    bz $r_result , $r_addr                      # If the result after shifting is zero, then jumpt to :hex_done              
    liw $r_addr , :hex_loop                     # Load the :hex_loop address into the address register
    add $r_addr , $pc_init , $r_addr            # Add the offset to the address
    jmp $r_addr                                 # Jump to the :hex_loop address

hex_done:
    liw $r_addr , $CX                           # Load the cursor x address into the address register
    stb $r_col , $r_addr                        # Store the current column in the cursor x address
    sub $r_col , $r_one , $r_col                # Decrement the column register by one
    lib $r_ascii , 0x78                         # Load the byte for 'x' into the ascii register
    liw $r_addr , $CELL                         # Load the cell address to into the address register
    stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address

    liw $r_addr , $CX                           # Load the cursor x address into the address register
    stb $r_col , $r_addr                        # Store the current column in the cursor x address
    sub $r_col , $r_one , $r_col                # Decrement the column register by one
    lib $r_ascii , 0x30                         # Load the byte for '0' into the ascii register
    liw $r_addr , $CELL                         # Load the cell address to into the address register
    stb $r_ascii , $r_addr                      # Store the ascii byte to the cell address

    liw $r_addr , $BLIT                         # Load the BLIT address into the address register
    stb r10 , $r_addr                           # Store anything to the BLIT address to blit the screen

liw $r_addr , :stall
add $r_addr , $pc_init , $r_addr
stall:
jmp $r_addr


hex_table:
    db 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46