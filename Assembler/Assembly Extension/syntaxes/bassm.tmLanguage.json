{
    "name": "Bashputer Assembly" , 
    "scopeName": "source.bassm" , 
    "patterns": 
    [
        {"include": "#comment"} , 
        {"include": "#assembler-command"} ,
        {"include": "#substitution-definition"} , 
        {"include": "#substitution-usage"} , 
        {"include": "#macro-variable"} , 
        {"include": "#label-definition"} , 
        {"include": "#label-usage"} , 
        {"include": "#mnemonic"} , 
        {"include": "#register"} , 
        {"include": "#operands"} 
    ] ,
    "repository": 
    {
        "comment": 
        {
            "begin": "#" ,
            "end": "/#|$" , 
            "name": "comment.inline.bassm"
        } ,
        "assembler-command":
        {
            "begin": "!" ,
            "end": "(?=;)|$",
            "name": "support.class.assm-cmd.bassm" , 
            "patterns": [{ "include": "#comment" }]
        } ,
        "substitution-definition":
        {
            "match": "\\b(def|undef)(?!:)\\b(?:\\s+([A-Za-z_]\\w*))?" , 
            "captures":
            {
                "1": {"name": "keyword.control.sub-def.bassm"} , 
                "2": {"name": "variable.other.sub-name.bassm"}
            }
        } ,
        "substitution-usage":
        {
            "match": "(\\$)([A-Za-z_]\\w*)" , 
            "captures":
            {
                "1": {"name": "constant.character.escape.sub-use.bassm"} , 
                "2": {"name": "variable.other.sub-name.bassm"}
            }
        } ,
        "macro-variable":
        {
            "match": "(%[A-Za-z_]\\w*)" , 
            "captures":
            {
                "1": {"name": "support.constant.property-value.macro-variable.bassm"}
            }
        } ,
        "label-definition":
        {
            "match": "(\\.)*\\b([A-Za-z_]\\w*)(:)" , 
            "captures": 
            {
                "1": {"name": "constant.character.escape.label-dot.bassm"} ,
                "2": {"name": "entity.name.type.label.bassm"} , 
                "3": {"name": "constant.character.escape.label-dot.bassm"}
            }
        } , 
        "label-usage":
        {
            "match": "(:)(\\.)*([A-Za-z_]\\w*)" , 
            "captures": 
            {
                "1": {"name": "constant.character.escape.label-dot.bassm"} ,
                "2": {"name": "constant.character.escape.label-dot.bassm"} , 
                "3": {"name": "entity.name.type.label.bassm"}
            }
        } , 
        "mnemonic":
        {
            "match": "(?i)\\b(nop|hlt|add|sub|inc|dec|neg|mul|div|rem|and|or|xor|not|lsr|asr|shl|ldb|ldq|ldh|ldw|stb|stq|sth|stw|lib|liq|lih|liw|eq|neq|lt|lts|le|les|bz|bnz|jmp|pshb|pshq|pshh|pshw|popb|popq|poph|popw|cal|cali|ret|mov|pc|sp|sjo|jmpi|bzi|bnzi|ssp|sspi|xsp|rnd|seed|ent|db)\\b" ,
            "captures": {"1": {"name": "keyword.other.instruction.bassm"}}
        } , 
        "register":
        {
            "match": "\\b[rR]\\d+\\b" , 
            "name": "variable.language.register.bassm"
        },
        "operands":
        {
            "patterns":
            [
                {
                    "match": "\\b0[xX][0-9A-Fa-f]+\\b" , 
                    "name": "constant.numeric.hex.bassm"
                } ,
                {
                    "match": "\\b0[bB][0-1]+\\b" , 
                    "name": "constant.numeric.binary.bassm"
                } ,
                {
                    "match": "\\b\\d+\\b" , 
                    "name": "constant.numeric.decimal.bassm"
                } ,
                {
                    "match": "[-+*/^%]" , 
                    "name": "keyword.operator.arithmetic.bassm"
                } , 
                {
                    "match": "=" , 
                    "name": "keyword.operator.assignment.bassm"
                }
            ]
        }
    }
}