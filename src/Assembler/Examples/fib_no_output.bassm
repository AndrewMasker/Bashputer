/def counter = r4               # The register with the counter
/def low = r1                   # The register with the low number
/def high = r2                  # The register with the high number
/undef high                     # Undefining this just to show
/def result = r3                # The result register

/def loop = r6                  # Define the loop variable
liw r6 , loop                   # Load the loop address into r6

/def r_loop_escape = r7         # The loop escape register
/def num_fib = (13 + 0x05)      # The number of fibonachi numbers to compute

/def one = r5                   # Define on to be the register r5
lib one , (1)                   # Set the register one to 1

liw counter , num_fib           # Set the counter register to num_fib
liw r7 , loop_escape            # Load the loop_escape address into r7
lib r1 , ( 0 )                  # Load zero into r1 as a byte
liw r2 , ( 0x01 )               # Load 1 into r2 as a word
loop:
    bz r4 , loop_escape         # Branch to 
    add r1 , r2 , r3            # Add r1 and r2 together and store in r3
    mov r2 r1; mov r3 r2        # Move r2 into r1 and r3 into r2

